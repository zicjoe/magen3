# Frontend (Vite)
VITE_API_URL=http://localhost:8787
VITE_CASPER_NETWORK=casper-testnet
VITE_CASPER_RPC_URL=https://node.testnet.casper.network/rpc
VITE_MAGEN3_CONTRACT_HASH=hash-b08ae51143e0d2fa78761e7819010e4c941dba3734252cdcf28ea7176cd4abcf

# Backend
NODE_ENV=development
PORT=8787
BACKEND_PORT=8787
PUBLIC_API_BASE_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=
DATABASE_SSL=false
ALLOW_MEMORY_STORE=true

# Casper decision-proof configuration
CASPER_NETWORK=casper-testnet
CASPER_CHAIN_NAME=casper-test
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
CASPER_RECORDING_MODE=manual
CASPER_AUTO_RECORD_DECISIONS=false
MAGEN3_CONTRACT_HASH=hash-b08ae51143e0d2fa78761e7819010e4c941dba3734252cdcf28ea7176cd4abcf
CASPER_CLIENT_BIN=casper-client
CASPER_CALL_PAYMENT_MOTES=3000000000
CASPER_RELAYER_TIMEOUT_MS=120000
CASPER_RELAYER_SECRET_KEY_PATH=
CASPER_RELAYER_SECRET_KEY_PEM=
CASPER_RELAYER_SECRET_KEY_B64=

# External-agent integration (backend only)
# MAGEN3_GATEWAY_URL is the Magen3 API BASE URL. Do not append /api/agent-gateway/intents.
MAGEN3_GATEWAY_URL=http://localhost:8787
MAGEN3_AGENT_ID=
MAGEN3_API_KEY=
MAGEN3_TIMEOUT_MS=15000
MAGEN3_AUTH_MODE=header

# Optional Casper SDK example inputs
CASPER_EXECUTION_WALLET=
CASPER_TARGET=
