# Magen3 local development template
# Copy this file to .env and replace placeholders. Never commit real secrets.

# Frontend
VITE_API_URL=http://localhost:8787
VITE_CASPER_NETWORK=casper-testnet
VITE_CASPER_RPC_URL=https://node.testnet.casper.network/rpc
VITE_MAGEN3_CONTRACT_HASH=hash-b08ae51143e0d2fa78761e7819010e4c941dba3734252cdcf28ea7176cd4abcf

# Backend
PORT=8787
PUBLIC_API_BASE_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/magen3
DATABASE_SSL=false
ALLOW_MEMORY_STORE=true

# External agent SDK / Python SDK / MCP
# Use the Magen3 API base URL only. Official clients add Gateway routes automatically.
MAGEN3_GATEWAY_URL=https://magen3-production.up.railway.app
MAGEN3_AGENT_ID=MAG-AGENT-...
MAGEN3_API_KEY=
MAGEN3_TIMEOUT_MS=15000
MAGEN3_AUTH_MODE=header

# Casper decision-proof anchoring
CASPER_NETWORK=casper-testnet
CASPER_CHAIN_NAME=casper-test
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
MAGEN3_CONTRACT_HASH=hash-b08ae51143e0d2fa78761e7819010e4c941dba3734252cdcf28ea7176cd4abcf
CASPER_RECORDING_MODE=manual
CASPER_AUTO_RECORD_DECISIONS=false
# CASPER_RELAYER_SECRET_KEY_PATH=/secure/path/to/secret_key.pem

# Optional security evidence providers
# Keep remote-feed allowlists narrow and use authenticated HTTPS endpoints.
THREAT_INTELLIGENCE_MODE=off
ORACLE_VALIDATION_MODE=off
COMPLIANCE_CONTROLS_MODE=off

# Milestone 15: optional trusted EVM stateful simulation adapter
# Requests cannot supply or override this URL. Use a testnet RPC unless mainnet support is explicitly approved.
STATEFUL_SIMULATION_EVM_RPC_URL=
STATEFUL_SIMULATION_EVM_PROVIDER_ID=
STATEFUL_SIMULATION_EVM_CHAIN_ID=
STATEFUL_SIMULATION_TIMEOUT_MS=8000
STATEFUL_SIMULATION_MAX_AGE_SECONDS=60

# Milestone 17: optional trusted EVM provider for asset-contract structural inspection.
# Falls back to STATEFUL_SIMULATION_EVM_* when omitted. Never accept RPC URLs from agent requests.
ASSET_CONTRACT_RISK_EVM_RPC_URL=
ASSET_CONTRACT_RISK_EVM_PROVIDER_ID=
ASSET_CONTRACT_RISK_EVM_CHAIN_ID=
ASSET_CONTRACT_RISK_TIMEOUT_MS=8000
# Optional Milestone 21 market-risk signal feed. Configure exactly one source.
MARKET_RISK_SIGNALS_FEED_JSON=
MARKET_RISK_SIGNALS_FEED_PATH=
MARKET_RISK_SIGNALS_FEED_URL=
MARKET_RISK_SIGNALS_API_KEY=
MARKET_RISK_SIGNALS_CACHE_TTL_MS=60000
MARKET_RISK_SIGNALS_MAX_FEED_AGE_MS=300000
MARKET_RISK_SIGNALS_REQUEST_TIMEOUT_MS=2500

