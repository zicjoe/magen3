# Frontend
VITE_API_BASE_URL=/api
VITE_CASPER_EXPLORER_URL=https://cspr.live

# Server
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=25000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# AI planner — server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_HISTORY_MESSAGES=12

# Magen3 — choose auto, gateway, or mcp
MAGEN3_INTEGRATION_MODE=auto
MAGEN3_BASE_URL=
MAGEN3_AGENT_ID=
MAGEN3_API_KEY=
MAGEN3_GATEWAY_PATH=/api/agent-gateway/intents

# Optional execution reconciliation endpoint in your Magen3 backend
MAGEN3_EXECUTION_PATH=

# Optional Magen3 MCP transport. In auto mode this is preferred when set.
MAGEN3_MCP_URL=
MAGEN3_MCP_EVALUATE_TOOL=evaluate_intent
MAGEN3_MCP_REPORT_TOOL=

# Protocol adapters
ZEROX_API_KEY=
ZEROX_API_BASE_URL=https://api.0x.org
# The hosted endpoint is Casper mainnet. Self-host the MCP server for testnet.
CSPR_TRADE_MCP_URL=https://mcp.cspr.trade/mcp
CSPR_TRADE_NETWORK=mainnet
CSPR_TRADE_MCP_PROTOCOL_VERSIONS=2025-11-25,2025-06-18,2025-03-26

# Persistence. PostgreSQL is recommended for Railway.
DATABASE_URL=
DATA_FILE=.data/yieldbot.json
PERSISTENCE_MEMORY_ONLY=false
