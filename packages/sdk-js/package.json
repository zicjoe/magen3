{
  "name": "@magen3/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for the Magen3 Agent Gateway API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "magen3",
    "casper",
    "web3",
    "ai-agent",
    "execution-firewall"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
