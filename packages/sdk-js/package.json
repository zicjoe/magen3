{
  "name": "@magen3/sdk",
  "version": "0.4.0-beta.3",
  "description": "Official TypeScript SDK for integrating autonomous agents with the Magen3 Agent Gateway.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "publish:check": "pnpm typecheck && pnpm build && pnpm test && npm pack --dry-run",
    "prepublishOnly": "pnpm typecheck && pnpm build && pnpm test"
  },
  "keywords": [
    "magen3",
    "web3",
    "ai-agent",
    "security",
    "execution-firewall",
    "blockchain"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
